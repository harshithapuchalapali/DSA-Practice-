Input:  arr[] = [1, 2, 3, -4, -1, 4]
Output: arr[] = [1, -4, 2, -1, 3, 4]

solution :
arr = [1, 2, 3, -4, -1, 4]
pos=[]
neg=[]
for i in arr:
    if i>=0:
        pos.append(i)
    else:
        neg.append(i)

posId=0
negId=0

i=0
while posId<len(pos) and negId<len(neg):
    if i%2==0:
        arr[i]=pos[posId]
        posId+=1
    else:
        arr[i]=neg[negId]
        negId+=1
    i+=1

while posId < len(pos):
        arr[i] = pos[posId]
        posId += 1
        i += 1

while negId < len(neg):
    arr[i] = neg[negId]
    negId += 1
    i += 1
print(arr)
