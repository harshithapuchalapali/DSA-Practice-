solution:

list=[10,20,30,30,30,40,50,30,30,30,30,30,40,10,10]
count=1
current_start=0

max_count=0
max_start=0
max_end=0

for i in range(1,len(list)):
    if list[i]==list[i-1]:
        count+=1
    else:
        count=1
        current_start=i
    if count> max_count:
        max_count=count
        max_start=current_start
        max_end=i
#print(list[max_start:max_end+1])
print(list[max_start])
print(max_start, max_end+1)

