Input: a[] = [1, 2, 5, 4, 0], b[] = [2, 4, 5, 0, 1]
Output: true
  
def checkPermutation(a, b):

    # 1. Different lengths → cannot be permutations
    if len(a) != len(b):
        return False

    # 2. Count elements in a
    freq = {}

    for x in a:
        freq[x] = freq.get(x, 0) + 1

    # 3. Check elements in b
    for x in b:

        # x doesn't exist in a
        if x not in freq:
            return False

        # No unused copy of x remains
        if freq[x] == 0:
            return False

        # Use one copy
        freq[x] -= 1

    # Everything matched
    return True
