definition : Scan the whole line, pick the shortest person, and send them to the front.
time : o(n^2)
space : o(1)

[5 2 9 1]  → [1 5 9 2] → [1 2 9 5] → [1 2 5 9]

def selection_sort(a):
    n = len(a)
    for i in range(n):
        min_idx = i
        for j in range(i + 1, n):
            if a[j] < a[min_idx]:
                min_idx = j
        a[i], a[min_idx] = a[min_idx], a[i]
    return a
